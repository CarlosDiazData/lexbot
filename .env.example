# Embedding provider: gemini | openai | fake
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Agent LLM (api service). LLM_PROVIDER: gemini | openai | fake.
# LLM_MODEL defaults to gemini-3.6-flash (gemini) / gpt-4o-mini (openai) when unset.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# PostgreSQL for the agent's case/follow-up tools.
# Native (non-Docker) runs reach it on localhost:5432. Inside docker compose
# the api service overrides this with the db service host (db:5432) — see
# docker-compose.yml.
DATABASE_URL=postgresql://lexbot:lexbot@localhost:5432/lexbot

# Telegram channel (TG-3): direct Bot API — no bridge service.
# Empty values = stub mode; the stack still boots (TG-3.1).
#   TELEGRAM_BOT_TOKEN    — from @BotFather (create the bot, copy the token)
#   TELEGRAM_CHAT_ID      — chat to notify / reply in; get it from @userinfobot
#   TELEGRAM_WEBHOOK_SECRET — secret token Telegram sends in the
#                           X-Telegram-Bot-Api-Secret-Token header; the API
#                           rejects every update without a matching secret
#                           (fail closed)
#   TELEGRAM_WEBHOOK_URL  — public HTTPS URL of the api service
#                           (http://localhost:8000/webhook/telegram behind an
#                           ngrok/cloudflared tunnel); unset → no setWebhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# CORS browser origins allowed to call the API (comma-separated list).
# Unset → default http://localhost:5173 (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Base URL the React UI uses for the LexBot API (default http://localhost:8000).
# NOTE: Vite reads env files from the Vite project root only, so the operative
# template is ui/.env.example. Copy it to ui/.env.local and set VITE_API_URL
# there; this root-level copy exists for discoverability.
VITE_API_URL=http://localhost:8000
