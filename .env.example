# Embedding provider: gemini | openai | fake
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Agent LLM (api service). LLM_PROVIDER: gemini | openai | fake.
# LLM_MODEL defaults to gemini-2.0-flash (gemini) / gpt-4o-mini (openai) when unset.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# PostgreSQL for the agent's case/follow-up tools.
# Native (non-Docker) runs reach it on localhost:5432. Inside docker compose
# the api service overrides this with the db service host (db:5432) — see
# docker-compose.yml.
DATABASE_URL=postgresql://lexbot:lexbot@localhost:5432/lexbot

# Optional n8n webhook for notify_whatsapp. Empty = stub mode (no real send).
N8N_WEBHOOK_URL=

# CORS browser origins allowed to call the API (comma-separated list).
# Unset → default http://localhost:5173 (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Base URL the React UI uses for the LexBot API (default http://localhost:8000).
# NOTE: Vite reads env files from the Vite project root only, so the operative
# template is ui/.env.example. Copy it to ui/.env.local and set VITE_API_URL
# there; this root-level copy exists for discoverability.
VITE_API_URL=http://localhost:8000
