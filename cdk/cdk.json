{
  "app": "npx ts-node --prefer-ts-exts bin/lexbot-infra.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "region": "us-east-1",
    "envName": "prod",
    "budgetLimitUsd": 45,
    "taskCpu": 512,
    "taskMemoryMiB": 1024,
    "budgetEmail": "alerts@example.com",
    "telegramChatId": "",
    "corsOrigins": "http://localhost:5173",
    "sourceUrlBase": "https://github.com/CarlosDiazData/lexbot/blob/main/docs/knowledge"
  }
}